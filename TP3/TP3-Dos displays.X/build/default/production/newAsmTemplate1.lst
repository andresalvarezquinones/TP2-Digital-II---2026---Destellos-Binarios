                      00053 ; =========================================
                      00054 ; PROGRAMA PRINCIPAL
                      00055 ; Refresca displays y controla el boton
                      00056 ; =========================================
0025                  00057 PRINCIPAL:
0025   2???           00058         CALL DISPLAYS           ; Mostrar continuamente los dos numeros
0026   1283 1303      00059         BANKSEL PORTE
0028   1809           00060         BTFSC PORTE,0           ; Preguntar si RE0 esta en 0
0029   2???           00061         GOTO PRINCIPAL          ; Si no se presiono, seguir esperando
002A   2???           00062         CALL ANTIRREBOTE        ; Evitar rebotes del pulsador
002B   1283 1303      00063         BANKSEL PORTE
002D   1809           00064         BTFSC PORTE,0           ; Comprobar nuevamente el boton
002E   2???           00065         GOTO PRINCIPAL          ; Si fue un rebote, volver
002F   2???           00066         CALL SUMAR              ; Si sigue presionado, sumar uno
